{
  "name": "yesbrainer",
  "private": true,
  "version": "0.0.0",
  "description": "A council of AI models for the decisions that aren't no-brainers — browser-only, BYOK, no backend.",
  "license": "AGPL-3.0-only",
  "author": "Oleksii Trekhleb (https://trekhleb.dev)",
  "homepage": "https://yesbrainer.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/trekhleb/yesbrainer.git"
  },
  "bugs": "https://github.com/trekhleb/yesbrainer/issues",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev-secure": "node scripts/gen-dev-cert.mjs && VITE_HTTPS=1 vite --host",
    "lan-relay": "node scripts/lan-relay.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "typecheck:coverage": "type-coverage -p tsconfig.app.json --strict --at-least 99.7",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:gallery": "node scripts/visual-gallery.mjs",
    "update-models-catalog": "node scripts/update-models-catalog.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.77",
    "@ai-sdk/google": "^3.0.73",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/provider": "^3.0.10",
    "@lobehub/icons": "^5.8.0",
    "@shikijs/rehype": "^4.0.2",
    "ai": "^6.0.177",
    "baseui": "^16.1.1",
    "dexie": "^4.4.2",
    "katex": "^0.16.46",
    "ollama-ai-provider-v2": "^3.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "type-coverage": "^2.29.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dompurify": "^3.4.11",
    "js-cookie": "^3.0.6"
  }
}
